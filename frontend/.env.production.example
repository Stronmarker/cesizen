# API URL pour le build web de production (npm run build → dist/)
#
# Vite charge automatiquement .env.production en mode build.
# Copier ce fichier en .env.production et ajuster l'URL.
#
# Backend déployé :
VITE_API_URL=https://api.cesizen.fr/api/v1
#
# Test local (backend lancé via make up) :
# VITE_API_URL=http://localhost:8080/api/v1
